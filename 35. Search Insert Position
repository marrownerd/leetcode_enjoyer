class Solution(object):
    def searchInsert(self, nums, target):
        left = 0
        h = 0
        right= len(nums)-1
        while left <= right:
            i = (left+right)//2
            if nums[i]==target:
                return i
                h=i
            elif nums[i]<target:
                left += 1
                h = i+1
            else:
                right -= 1
                h = i
        return h
