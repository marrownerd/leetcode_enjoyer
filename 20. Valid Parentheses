class Solution(object):
    def isValid(self, s):
        stack = []
        mapping = {")":"(", "}": "{", "]": "["}

        for char in s:
            if char in mapping:
                to_el = stack.pop() if stack else '#'
                
                if to_el != mapping[char]:
                    return False
            else:
                stack.append(char)
    
        return len(stack) == 0

        return True
