class Solution(object):
    def search(self, nums, target):
        right = len(nums)-1
        left = 0        
        while left <= right:
            mid = (left + right)//2
            if nums[mid] < target:
                left = mid +1
            elif nums[mid] == target:
                return mid
            else:
                right = mid - 1
        return -1
