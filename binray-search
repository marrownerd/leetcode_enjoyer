class Solution(object):
    def search(self, nums, target):
        n = len(nums)
        i = n//2
        m = 0
        numb = -1
        while 0 <= i <= n-1: 
            if nums[i] < target:
                i -= i//2
            elif nums[i] == target:
                numb = i
            else:
                i += i//2
        return numb
